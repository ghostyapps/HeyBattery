<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top"
        android:layout_gravity="top">

        <!-- Header section (top gray area) -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:orientation="vertical"
            android:background="@color/header_background"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_marginBottom="40dp">

            <ImageView
                android:id="@+id/headerLogo"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:src="@drawable/battery_icon"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Header logo"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/batteryPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textSize="72sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_black"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="is your current battery level."
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_bold"
                android:layout_marginBottom="40dp"/>

            <!-- Time Since Last Full Charge -->
            <TextView
                android:id="@+id/timeSinceCharge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 hours and 47 minutes"
                android:textSize="32sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_black"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="have passed since >80% charge."
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_bold"
                android:layout_marginBottom="40dp"/>

            <!-- Deep Sleep Time Since >80% Charge -->
            <TextView
                android:id="@+id/deepSleepTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No data yet"
                android:textSize="32sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_black"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="deep sleep since >80% charge."
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_bold"
                android:layout_marginBottom="40dp"/>

            <!-- Estimated Remaining Time Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimated remaining time:"
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_bold"
                android:layout_marginBottom="8dp"/>

            <!-- Estimated Remaining Time -->
            <TextView
                android:id="@+id/remainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculating..."
                android:textSize="32sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_black"
                android:layout_marginBottom="40dp"/>

            <!-- About HeyBattery -->
            <TextView
                android:id="@+id/aboutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About HeyBattery"
                android:textSize="18sp"
                android:textColor="@color/text_color"
                android:fontFamily="@font/productsans_bold"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
