<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="48dp">

        <!-- HEADER KISMI (AYNI) -->
        <LinearLayout
            android:id="@+id/aboutHeader"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/header_background"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/aboutHeaderLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/battery_icon_cropped"
                android:contentDescription="About header logo" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/aboutBackButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start|center_vertical"
                    android:src="@drawable/ic_back_arrow"
                    android:contentDescription="Back"
                    android:padding="4dp"
                    android:layout_marginStart="24dp" />

                <TextView
                    android:id="@+id/aboutHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="About"
                    android:textSize="24sp"
                    android:fontFamily="@font/productsans_black"
                    android:textColor="@color/text_color" />
            </FrameLayout>
        </LinearLayout>

        <!-- WHAT IS HEYBATTERY? -->
        <TextView
            android:id="@+id/aboutTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="What is HeyBattery?"
            android:textSize="28sp"
            android:textColor="@color/text_color"
            android:fontFamily="@font/productsans_black"
            android:layout_marginTop="32dp"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/aboutHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/aboutText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/text_color"
            android:fontFamily="@font/productsans_medium"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:justificationMode="inter_word"
            android:text="@string/about_description"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/aboutTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- YENİ EKLENEN KISIM: WHY NOTIFICATION? -->
        <TextView
            android:id="@+id/notificationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Why the Notification?"
            android:textSize="28sp"
            android:textColor="@color/text_color"
            android:fontFamily="@font/productsans_black"
            android:layout_marginTop="32dp"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/aboutText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/notificationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/text_color"
            android:fontFamily="@font/productsans_medium"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:justificationMode="inter_word"
            android:text="Modern Android systems are very aggressive about saving power. They often 'kill' background apps, which means HeyBattery might miss the exact moment you unplug your charger.\n\nThe persistent notification acts as a shield. It tells the system: 'I am working, please don't stop me.'\n\nDon't worry! It consumes 0% CPU and has no impact on your battery life. It simply waits for the unplug event to give you 100% accurate statistics. \n\Please don't disable it if you want to see accurate results."
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/notificationTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CONTRIBUTORS (Yeri aşağı kaydırıldı) -->
        <TextView
            android:id="@+id/aboutContributors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Contributors:\n\nB. Sun: For suggesting the Watt / Volt / mA charging info cycling feature.\n\nŞ. Kuşçu: For helping to solve the correct algorithm on calculating the remaining time to 100%."
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:fontFamily="@font/productsans_medium"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/notificationText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- VERSION (Constraint eklendi) -->
        <TextView
            android:id="@+id/aboutVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:fontFamily="@font/productsans_medium"
            android:gravity="center"
            android:text="Version 0.1.0"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="48dp"
            app:layout_constraintTop_toBottomOf="@id/aboutContributors"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>