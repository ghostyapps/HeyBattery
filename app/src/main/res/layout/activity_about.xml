<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/aboutHeader"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/header_background"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/aboutHeaderLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/battery_icon_cropped"
            android:contentDescription="About header logo" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/aboutBackButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back"
                android:padding="4dp"
                android:layout_marginStart="24dp" />

            <TextView
                android:id="@+id/aboutHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="About"
                android:textSize="24sp"
                android:fontFamily="@font/productsans_black"
                android:textColor="@color/text_color" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/aboutTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="What is HeyBattery?"
        android:textSize="28sp"
        android:textColor="@color/text_color"
        android:fontFamily="@font/productsans_black"
        android:layout_marginTop="48dp"
        android:gravity="start"
        android:textAlignment="viewStart"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/aboutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/aboutText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/text_color"
        android:fontFamily="@font/productsans_medium"
        android:gravity="start"
        android:textAlignment="viewStart"
        android:justificationMode="inter_word"
        android:text="HeyBattery is a simple battery application.\nIt briefly calculates your current charge level, how much time has passed since your last charge over 80%, and estimates how long you can keep using your phone based on previous usage statistics.\nThis estimation is recalculated continuously using your remaining battery percentage and the historical usage patterns stored in memory.\n\nDeep sleep is calculated using the formula:\n(elapsedRealtime – uptimeMillis).\n\nIn other words, even if the screen is off, if an app is still running in the background and the CPU is active, the device does not enter deep sleep.\nBut when the CPU stops working, deep sleep time increases.\nThis helps you understand whether your phone is actually resting or if something is keeping it awake in the background.\n\nThe Charging Info section shows real-time charging data. When you tap on it, the displayed value cycles between Watts, Volts, and milliamps (mA).\nThis allows you to check how much power your charger is delivering and observe the health and behavior of your battery during charging."
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/aboutTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/aboutContributors"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Contributors:
        \nB. Sun: for suggesting the Watt / Volt / mA charging info cycling feature.
        \nŞ. Kuşçu: for helping to solve the correct algorithm on calculating the remaining time to 100%. "
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:fontFamily="@font/productsans_medium"
        android:gravity="start"
        android:textAlignment="viewStart"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/aboutText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>